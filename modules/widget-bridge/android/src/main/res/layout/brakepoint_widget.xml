<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_bg_dark"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingHorizontal="16dp"
  android:paddingVertical="12dp">

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/widget_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="🍺 오늘"
      android:textColor="#9aa0ab"
      android:textSize="11sp" />

    <TextView
      android:id="@+id/widget_count"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="취기 0%"
      android:textColor="#f3f5f8"
      android:textSize="22sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_sub"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="한계까지 0잔"
      android:textColor="#9aa0ab"
      android:textSize="11sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/widget_add"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_btn_dark"
    android:minWidth="52dp"
    android:gravity="center"
    android:paddingHorizontal="18dp"
    android:paddingVertical="12dp"
    android:text="+1"
    android:textColor="#ffffff"
    android:textSize="20sp"
    android:textStyle="bold" />
</LinearLayout>
